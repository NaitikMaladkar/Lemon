<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Lemon" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/lemon_deep</item>
        <item name="colorPrimaryDark">@color/lemon_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/leaf_green</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/lemon_pale</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="android:statusBarColor">@color/lemon_deep</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="materialButtonStyle">@style/Widget.Lemon.Button</item>
        <item name="materialCardViewStyle">@style/Widget.Lemon.Card</item>
    </style>

    <!-- Blocks screenshots and screen recording on every screen. -->
    <style name="Theme.Lemon.Secure" parent="Theme.Lemon">
        <item name="android:windowBackground">@color/lemon_pale</item>
    </style>

    <style name="Widget.Lemon.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/lemon_deep</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="Widget.Lemon.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/lemon_light</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="TextAppearance.Lemon.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextAppearance.Lemon.Secret" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="Widget.Lemon.PinKey" parent="Widget.Material3.Button.TextButton">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="cornerRadius">20dp</item>
    </style>
</resources>
