<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pin_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <FrameLayout
        android:id="@+id/pin_logo"
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/bg_icon_circle">

        <ImageView
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_gravity="center"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_lemon" />
    </FrameLayout>

    <TextView
        android:id="@+id/pin_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="@string/pin_unlock"
        android:textAppearance="@style/TextAppearance.Lemon.Title" />

    <TextView
        android:id="@+id/pin_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/pin_hint_text"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/pin_dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:orientation="horizontal" />

    <ProgressBar
        android:id="@+id/pin_busy"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginTop="18dp"
        android:indeterminateTint="@color/lemon_deep"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/pin_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:textColor="@color/danger"
        android:textSize="14sp"
        android:visibility="gone" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <include
        android:id="@+id/keypad"
        layout="@layout/view_pin_keypad" />
</LinearLayout>
