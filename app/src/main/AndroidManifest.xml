<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".LemonApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lemon">

        <activity
            android:name=".ui.PinActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Lemon.Secure">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.SetupActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Lemon.Secure" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Lemon.Secure" />

        <activity
            android:name=".ui.AddEditActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Lemon.Secure"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.AddTotpActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Lemon.Secure"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.ScannerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Lemon.Secure" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Lemon.Secure" />

    </application>

</manifest>
